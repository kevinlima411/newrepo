# .env.example — copy to .env and fill in real values
# NEVER commit .env to git

# GitHub (dashboard)
GITHUB_TOKEN=ghp_xxx

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-xxx

# Twilio (SMS — use API Key pair, NOT Auth Token)
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_API_KEY=SKxxx
TWILIO_API_SECRET=xxx

# Wassenger (WhatsApp MCP)
WASSENGER_API_KEY=xxx

# OpenRouter
OPENROUTER_API_KEY=sk-or-xxx

# Google Sheets service account key file path
GOOGLE_SHEETS_CREDENTIALS=/home/kevin/secrets/service-account.json

# Dashboard
SECRET_KEY=change-me
PORT=5555
